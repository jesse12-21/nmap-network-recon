# shellcheck shell=bash
# shellcheck disable=SC2034  # variables are consumed by the sourcing shell
# Nmap scan profiles. Source this file, then use the variables unquoted so the
# shell performs word splitting:
#
#   source profiles/profiles.env
#   # shellcheck disable=SC2086
#   sudo nmap $PROFILE_STANDARD -oA results/scan 198.51.100.0/24

# Host discovery only. No port scan. Establishes scope before touching anything.
PROFILE_DISCOVERY="-sn -PE -PS80,443,22 -PA80 -n"

# Routine assessment: top 1000 TCP, service versions, default scripts.
PROFILE_STANDARD="-sS --top-ports 1000 -sV --version-intensity 5 -sC -T4"

# Deep assessment. All TCP ports plus the top 100 UDP, OS detection, vuln scripts.
# Slow and loud. Requires a maintenance window on anything production.
PROFILE_THOROUGH="-sS -p- -sU --top-ports 100 -sV --version-all -O --osscan-guess --script vuln -T4"

# Minimal footprint. Serialised timing, no host discovery ping, small port set.
# For fragile networks and OT/ICS, and for staying under rate-based detection.
PROFILE_QUIET="-sS --top-ports 100 -T1 --max-rate 10 --scan-delay 1s -Pn -n"

# Purple-team: deliberately attributable. Emits an engagement marker so the SOC
# can distinguish authorised testing from a real intrusion.
PROFILE_PURPLE="-sS --top-ports 1000 -sV --script=./nse/http-scan-attribution.nse --script-args http-scan-attribution.id=PURPLE-EXERCISE -T3"

# IPv6 equivalents. IPv6 hosts are routinely missed because -6 is forgotten,
# and a dual-stack host firewalled on v4 is often wide open on v6.
PROFILE_DISCOVERY_V6="-6 -sn -PS80,443,22 -n"
PROFILE_STANDARD_V6="-6 -sS --top-ports 1000 -sV -T4"
